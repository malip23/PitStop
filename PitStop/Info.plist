<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>PitStop</string>
	<key>GEMINI_API_KEY</key>
	<string>$(GEMINI_API_KEY)</string>
	<key>AI_PROXY_HOST</key>
	<string>$(AI_PROXY_HOST)</string>
	<key>AI_PROXY_TOKEN</key>
	<string>$(AI_PROXY_TOKEN)</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.malipeters.PitStop</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pitstop</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>audio</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>PitStop uses your location to track your run, show nearby partner businesses, and route you to Off-Peak Quests.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>PitStop keeps tracking your run and checks you in at quest businesses even when your phone is locked.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>PitStop saves your run card image to Photos when you choose Save Image.</string>
	<key>NSMotionUsageDescription</key>
	<string>PitStop compares your step cadence with GPS speed to verify quest runs are real.</string>
</dict>
</plist>
