// Template for Secrets.xcconfig (which is git-ignored).
// Copy this file to Secrets.xcconfig in the same folder and paste your real key.
GEMINI_API_KEY = YOUR_KEY_HERE

// Recommended: your Cloudflare Worker (see proxy/README.md). Host only, no https:// ("//" is a comment here).
AI_PROXY_HOST = YOUR_WORKER_HOST
AI_PROXY_TOKEN = YOUR_TOKEN
